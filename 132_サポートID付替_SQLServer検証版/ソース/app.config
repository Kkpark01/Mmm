<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- 空欄のままでは接続しません。利用環境に応じて設定します。 -->
    <add key="Server" value="" />
    <add key="Database" value="" />
    <add key="Authentication" value="Windows" />
    <!-- 運用が決まるまで空欄。WindowsまたはFixedを明示します。 -->
    <add key="AuditUserMode" value="" />
    <add key="AuditUser" value="" />
    <add key="TrustServerCertificate" value="false" />
  </appSettings>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0,Profile=Client" /></startup>
</configuration>
