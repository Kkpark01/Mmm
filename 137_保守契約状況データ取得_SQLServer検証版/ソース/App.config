<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- 接続先は会社で確認して設定。空欄のままでは接続しません。 -->
    <add key="Server" value="" />
    <add key="Database" value="" />
    <add key="Authentication" value="Windows" />
    <add key="TrustServerCertificate" value="false" />
    <add key="ConnectionTimeoutSeconds" value="15" />
    <add key="CommandTimeoutSeconds" value="120" />
  </appSettings>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" /></startup>
</configuration>
